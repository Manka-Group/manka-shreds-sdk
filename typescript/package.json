{
  "name": "@manka-shreds/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the manka-shreds Solana shred stream",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "dependencies": {
    "@matrixai/quic": "^2.0.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "solana",
    "shred",
    "manka-shreds",
    "streaming"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Manka-Group/manka-shreds-sdk.git",
    "directory": "typescript"
  },
  "homepage": "https://docs.manka.wtf",
  "bugs": {
    "url": "https://github.com/Manka-Group/manka-shreds-sdk/issues"
  }
}
